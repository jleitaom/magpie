<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Quick Save asks Safari for its front tab with Apple Events. The hardened runtime blocks
	     that unless the app says it needs it (macOS still asks the person the first time). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- The app and Sparkle.framework are signed with a self-signed certificate, which has no
	     Team ID, so the hardened runtime's library validation would refuse to load Sparkle. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
